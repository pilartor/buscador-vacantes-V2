# ── Gmail (obligatorio solo si NOTIFICACION_CANAL=email) ──
# Activar verificación en 2 pasos y generar una contraseña de aplicación:
# https://myaccount.google.com/apppasswords
EMAIL_REMITENTE=tu.email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Opcional: si se omite, se envía al mismo remitente
# EMAIL_DESTINATARIO=otro@email.com

# ── Canal de notificación: email | consola ──
# "consola" es útil para probar sin configurar Gmail.
NOTIFICACION_CANAL=consola
